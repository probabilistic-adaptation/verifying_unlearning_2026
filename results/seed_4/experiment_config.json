{
    "description": "Testing first draft of official pipeline",
    "device": "cuda",
    "model_class": "ResNet",
    "unlearning_type": "class",
    "num_runs": 1,
    "measure_base_results": false,
    "measure_retrain_results": false,
    "data": {
        "dataset": "CIFAR10",
        "num_classes": 10,
        "batch_size": 512,
        "num_workers": 4,
        "item_to_unlearn": 5
    },
    "training": {
        "num_epochs": 100,
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "batch_print_freq": 5,
        "pretrained_seed": 4,
        "retrained_from_scratch_seeds": {
            "class": 4,
            "percents": -99
        }
    },
    "unlearning": {
        "methods": [
            "boundary_shrink"
        ],
        "FT": {
            "print_freq": 8,
            "lr": 0.01,
            "opt": "SGD",
            "weight_decay": 0.0005,
            "num_epochs": 10,
            "save_checkpoints_at": [
                5,
                10
            ]
        },
        "GA": {
            "print_freq": 1,
            "lr": 0.0002,
            "opt": "SGD",
            "weight_decay": 0.0005,
            "num_epochs": 5,
            "save_checkpoints_at": [
                3,
                5
            ]
        },
        "NegGrad_plus": {
            "print_freq": 8,
            "lr": 0.01,
            "opt": "SGD",
            "weight_decay": 0.0005,
            "num_epochs": 10,
            "save_checkpoints_at": [
                5,
                10
            ],
            "alpha": 0.999
        },
        "RL": {
            "print_freq": 8,
            "lr": 0.01,
            "opt": "SGD",
            "weight_decay": 0.0005,
            "num_epochs": 10,
            "save_checkpoints_at": [
                5,
                10
            ]
        },
        "SalUn": {},
        "boundary_shrink": {
            "print_freq": 1,
            "lr": 1e-05,
            "num_epochs": 10,
            "save_checkpoints_at": [
                5,
                10
            ],
            "bound": 0.1,
            "opt": "SGD"
        },
        "boundary_expanding": {
            "lr": 1e-05,
            "num_epochs": 10,
            "save_checkpoints_at": [
                5,
                10
            ],
            "opt": "SGD"
        },
        "bad_teacher": {
            "print_freq": 3,
            "lr": 0.0001,
            "num_epochs": 2,
            "save_checkpoints_at": [
                1,
                2
            ],
            "opt": "Adam"
        },
        "scrub": {
            "print_freq": 3,
            "opt": "Adam",
            "weight_decay": 0.0005,
            "lr": 0.0005,
            "num_epochs": 3,
            "maxsteps": 2,
            "save_checkpoints_at": [
                1,
                2,
                3
            ]
        }
    },
    "GRAND_SEED": 4
}