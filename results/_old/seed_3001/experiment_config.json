{
    "description": "Testing data loader rotation, higher LR - GA, forget vs retain acc, random forgetting",
    "device": "mps",
    "model_class": "ConvNet",
    "num_runs": 3,
    "retrain_from_scratch": false,
    "train_base": true,
    "data": {
        "batch_size": 256,
        "num_workers": 0
    },
    "training": {
